# Copy to .env.local (or run ./setup-local-env.sh to pull from Vercel).

# Clerk (new Sasha application; enable Organizations for team-wide sharing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Blob (uploads)
BLOB_READ_WRITE_TOKEN=

# Neon Postgres (documents, sources, workflows, audit log)
POSTGRES_URL=

# Gemini: reads uploads only (PDF/image text, OCR, tables)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Anthropic: classifier, suggestions, rubric checks, drafting (Phase 1+)
ANTHROPIC_API_KEY=
# SASHA_MODEL_FAST=claude-haiku-5-5
# SASHA_MODEL_MID=claude-sonnet-5-5
# SASHA_MODEL_DRAFT=claude-opus-5-5

# Optional: Vercel AI Gateway for workflow nodes that pick a "provider/model"
# AI_GATEWAY_API_KEY=

# Optional: server-to-server calls to /api/ontology/* (schema setup)
# INTERNAL_API_TOKEN=

# Local development only: skip sign-in and act as a fixed developer user.
# Ignored when NODE_ENV=production. Never set this on a deployment.
# SASHA_DEV_AUTH_BYPASS=1
